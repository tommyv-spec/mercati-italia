# Mercati d'Italia — Backend Configuration
# Copy this to .env and fill in your values.

# Firebase Admin SDK — choose ONE method:

# Method 1: Service account key file (recommended for local dev)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Method 2: Project ID only (for Cloud Run / Cloud Functions with default credentials)
# FIREBASE_PROJECT_ID=your-project-id
