rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the trusted server-side Firebase Admin SDK imports or edits markets.
    // NEVER allow untrusted browsers to write this collection.
    match /mercati/{marketId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /fonti/{fonteId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
    }

    // User-scoped favorites. Logged-out users keep favorites in localStorage.
    match /utenti/{userId}/preferiti/{marketId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }

    // Authenticated users may create their own reports but cannot mark them
    // resolved, rewrite their ownership or read anyone else's reports.
    match /segnalazioni/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'user_id', 'mercato_id', 'tipo', 'messaggio', 'dati', 'creato_il'
        ])
        && request.resource.data.tipo in [
          'confermato', 'annullato', 'orari_sbagliati', 'nuovo_mercato'
        ];
      allow read: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
